{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "public/**/*.ts",
    "public/**/*.d.ts",
    "bin/**/*.ts",
    "test/**/*.ts"
  ]
}
